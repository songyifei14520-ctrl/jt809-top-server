<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>cn.com.onlinetool</groupId>
    <artifactId>jt809</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>jt809-top-server</name>
    <description>JT/T 809 上级平台模拟服务（联调用）：主链路/从链路、2011/2019 版协议、JT/T 1078 视频、静态信息交换、下行控制</description>

    <modules>
        <module>jt809-base</module>
        <module>jt809-protocol</module>
        <module>jt809-netty-codec</module>
        <module>jt809-top-server</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <fastjson.version>1.2.83</fastjson.version>
        <knife4j.version>4.5.0</knife4j.version>
        <guava.version>32.1.2-jre</guava.version>
        <hutool.version>5.8.27</hutool.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.com.onlinetool</groupId>
                <artifactId>jt809-base</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.com.onlinetool</groupId>
                <artifactId>jt809-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.com.onlinetool</groupId>
                <artifactId>jt809-netty-codec</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
